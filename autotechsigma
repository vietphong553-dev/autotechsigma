function tbl3.ClearConnections()
    for _, charConnection in ipairs(tbl2.CharConnections) do
        if charConnection.Connected then
            charConnection:Disconnect()
        end
    end
    table.clear(tbl2.CharConnections)
end

function tbl3.GetTargetNode(character)
    if not character or not character.Parent then return nil end
    local Head = character:FindFirstChild("Head")
    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    local root = character:FindFirstChild("HumanoidRootPart")

    if tbl.TargetPart == "Head" then return Head or root end
    if tbl.TargetPart == "Neck" then return (Head and torso and Head) or torso or root end
    return torso or root
end

function tbl3.GetTargetPosition(character)
    if not character then return nil end
    if tbl.TargetPart == "Neck" then
        local Head = character:FindFirstChild("Head")
        local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
        if Head and torso then return (Head.Position + torso.Position) / 2 end
        if Head then return Head.Position - Vector3.new(0, 0.8, 0) end
    end
    local targetNode = tbl3.GetTargetNode(character)
    return targetNode and targetNode.Position or nil
end

function tbl3.IsFacingTarget(arg1)
    if not arg1 or not tbl2.RootPart then return false end
    local pos = tbl3.GetTargetPosition(arg1)
    if not pos then return false end

    local v2 = tbl2.RootPart.CFrame:PointToObjectSpace(pos)
    local v3 = -v2.Z
    local v4 = math.abs(v2.X)
    return v3 > -0.5 and v3 <= tbl.CheckLength and v4 <= tbl.CheckWidth
end

function tbl3.CancelDash()
    if not tbl2.RootPart then return end
    for _, child in ipairs(tbl2.RootPart:GetChildren()) do
        if child:IsA("BodyMover") or child:IsA("Constraint") or string.find(child.ClassName, "Velocity") or string.find(child.ClassName, "Force") then
            child:Destroy()
        end
    end
    tbl2.RootPart.AssemblyLinearVelocity = Vector3.new(0, tbl2.RootPart.AssemblyLinearVelocity.Y * 0.2, 0)
    tbl2.RootPart.AssemblyAngularVelocity = Vector3.zero
end

function tbl3.GetClosestTarget()
    local Character
    local huge = math.huge
    if not tbl2.RootPart then return nil end
    local Position = tbl2.RootPart.Position

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                local Magnitude = (Position - hrp.Position).Magnitude
                if Magnitude < huge and Magnitude <= tbl.MaxLockDistance then
                    Character = player.Character
                    huge = Magnitude
                end
            end
        end
    end

    for _, npcRoot in ipairs(tbl2.NpcList) do
        if npcRoot and npcRoot.Parent then
            local npcHum = npcRoot.Parent:FindFirstChildOfClass("Humanoid")
            if npcHum and npcHum.Health > 0 then
                local Magnitude1 = (Position - npcRoot.Position).Magnitude
                if Magnitude1 < huge and Magnitude1 <= tbl.MaxLockDistance then
                    huge = Magnitude1
                    Character = npcRoot.Parent
                end
            end
        end
    end
    return Character
end

local function func_stopNoclip()
    if tbl2.NoclipConnection then
        tbl2.NoclipConnection:Disconnect()
        tbl2.NoclipConnection = nil
    end
    for k, v in pairs(tbl2.EnemyPartsToNoclip) do
        if k and k.Parent then k.CanCollide = v end
    end
    table.clear(tbl2.EnemyPartsToNoclip)
end

local function func_pullTarget(arg1)
    if tbl2.PullConnection then
        tbl2.PullConnection:Disconnect()
        tbl2.PullConnection = nil
    end
    func_stopNoclip()
    local startTime = os.clock()

    if arg1 then
        for _, descendant in ipairs(arg1:GetDescendants()) do
            if descendant:IsA("BasePart") and not descendant:IsA("Accessory") then
                local Name = descendant.Name
                if not string.find(Name, "Leg") and not string.find(Name, "Foot") and Name ~= "HumanoidRootPart" then
                    tbl2.EnemyPartsToNoclip[descendant] = descendant.CanCollide
                end
            end
        end
        tbl2.NoclipConnection = RunService.Stepped:Connect(function()
            local elapsed = os.clock() - startTime
            if not arg1 or not arg1.Parent or elapsed >= tbl.PullDuration + tbl.NoclipExtraTime then
                func_stopNoclip()
                return
            end
            for k in pairs(tbl2.EnemyPartsToNoclip) do
                if k.Parent then k.CanCollide = false end
            end
        end)
    end

    tbl2.PullConnection = RunService.Heartbeat:Connect(function()
        if os.clock() - startTime >= tbl.PullDuration or not arg1 or not arg1.Parent then
            if tbl2.PullConnection then
                tbl2.PullConnection:Disconnect()
                tbl2.PullConnection = nil
            end
            return
        end
        local targetNode = tbl3.GetTargetNode(arg1)
        if not targetNode or not tbl2.RootPart then return end
        local dir = targetNode.Position - tbl2.RootPart.Position
        if dir.Magnitude > 0.05 then
            tbl2.RootPart.AssemblyLinearVelocity = tbl2.RootPart.AssemblyLinearVelocity:Lerp(dir.Unit * tbl.PullForce, tbl.Smooth)
        end
    end)
end

local function func2()
    if not tbl.Enabled or tbl2.IsChecking then return end
    local target = tbl3.GetClosestTarget()
    if not target then return end
    local pos = tbl3.GetTargetPosition(target)
    if not pos or not tbl2.RootPart or (tbl2.RootPart.Position - pos).Magnitude > tbl.MaxLockDistance then return end

    tbl2.IsChecking = true
    local start = os.clock()
    local connection
    connection = RunService.Heartbeat:Connect(function()
        local elapsed = os.clock() - start
        if elapsed > tbl.WindowEnd or not target or not target.Parent then
            connection:Disconnect()
            tbl2.IsChecking = false
            return
        end
        if elapsed >= tbl.WindowStart and elapsed <= tbl.WindowEnd then
            local currentPos = tbl3.GetTargetPosition(target)
            if not currentPos then return end
            if (tbl2.RootPart.Position - currentPos).Magnitude <= tbl.StickDistance then
                if tbl3.IsFacingTarget(target) then
                    connection:Disconnect()
                    tbl2.IsChecking = false
                    tbl3.CancelDash()
                    tbl2.RootPart.CFrame = CFrame.new(currentPos)
                    func_pullTarget(target)
                end
            end
        end
    end)
end

local function func3()
    if not tbl.Enabled then return end
    local target = tbl3.GetClosestTarget()
    if not target then return end
    local targetHrp = target:FindFirstChild("HumanoidRootPart")
    if not targetHrp or not tbl2.RootPart then return end
    if (tbl2.RootPart.Position - targetHrp.Position).Magnitude > 22 then return end

    local tpTime = math.clamp(tbl.FraudConfig.TP_Time, 0.6, 0.75)
    task.spawn(function()
        local start = os.clock()
        local connection
        connection = RunService.Heartbeat:Connect(function()
            if os.clock() - start >= tpTime then
                connection:Disconnect()
                pcall(function()
                    if not target or not target.Parent or not tbl2.RootPart or not tbl2.RootPart.Parent then return end
                    if not Humanoid or Humanoid.Health <= 0 then return end
                    local hrp = target:FindFirstChild("HumanoidRootPart")
                    if not hrp or not hrp.Parent then return end
                    local mag = (tbl2.RootPart.Position - hrp.Position).Magnitude
                    if mag > 25 or (tbl2.RootPart.AssemblyLinearVelocity.Y < -40 and tbl2.RootPart.Position.Y < 10) then return end
                    local torso = target:FindFirstChild("Torso") or target:FindFirstChild("UpperTorso") or hrp
                    if torso then
                        local finalPos = torso.Position + Vector3.new(0, 0.5, 0)
                        if finalPos.Y < -50 then return end
                        tbl2.RootPart.CFrame = CFrame.new(finalPos)
                        tbl2.RootPart.AssemblyLinearVelocity = Vector3.zero
                    end
                end)
                return
            end
            if not target or not target.Parent then
                connection:Disconnect()
                tbl1.IsChecking = false
            end
        end)
    end)
end

local function func4()
    local Live = Workspace:FindFirstChild("Live")
    if not Live or not HumanoidRootPart then return nil end
    local maxDist = 150
    local closest
    for _, child in ipairs(Live:GetChildren()) do
        if child:IsA("Model") and child ~= v1 then
            if child.Name == "Weakest Dummy" or Players:GetPlayerFromCharacter(child) then
                local hrp = child:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local mag = (HumanoidRootPart.Position - hrp.Position).Magnitude
                    if mag < maxDist then
                        closest = child
                        maxDist = mag
                    end
                end
            end
        end
    end
    return closest
end

local function func5()
    local humanoidRootPart = HumanoidRootPart
    local humanoid = Humanoid
    local target = func4()

    if not target or not humanoidRootPart or not humanoid then
        pcall(function()
            if humanoid and humanoid.Parent then
                humanoid.AutoRotate = true
                humanoid:ChangeState(Enum.HumanoidStateType.Landed)
                humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, -5, 0)
            end
        end)
        flag = false
        return
    end

    local targetHrp = target:FindFirstChild("HumanoidRootPart")
    if not targetHrp or not targetHrp.Parent or (humanoidRootPart.Position - targetHrp.Position).Magnitude > 25 then
        pcall(function()
            if humanoid and humanoid.Parent then
                humanoid.AutoRotate = true
                humanoid:ChangeState(Enum.HumanoidStateType.Landed)
            end
        end)
        flag = false
        return
    end

    local start = tick()
    local connection
    connection = RunService.Heartbeat:Connect(function()
        local elapsed = tick() - start
        if not flag1 or elapsed > tbl.LoopConfig.LOCK_DURATION or not targetHrp or not targetHrp.Parent or not humanoidRootPart or not humanoidRootPart.Parent then
            pcall(function()
                if humanoid and humanoid.Parent then
                    humanoid.AutoRotate = true
                    if humanoidRootPart.AssemblyLinearVelocity.Y < -40 then
                        humanoidRootPart.AssemblyLinearVelocity = Vector3.new(humanoidRootPart.AssemblyLinearVelocity.X, -10, humanoidRootPart.AssemblyLinearVelocity.Z)
                    end
                end
            end)
            connection:Disconnect()
            flag = false
            return
        end

        local enemyHum = target:FindFirstChildOfClass("Humanoid")
        if not enemyHum or enemyHum.Health <= 0 then
            if humanoid.Parent then humanoid.AutoRotate = true end
            connection:Disconnect()
            flag = false
            return
        end

        pcall(function()
            humanoid.AutoRotate = false
            local DataPing = Stats.Network.ServerStatsItem:FindFirstChild("Data Ping")
            local pingVal = DataPing and DataPing:GetValue() / 1000
            local vel = targetHrp.AssemblyLinearVelocity
            local predict = 0.4 - elapsed + (pingVal or 0)
            local vector3 = Vector3.new(targetHrp.Position.X + vel.X * predict, humanoidRootPart.Position.Y, targetHrp.Position.Z + vel.Z * predict)
            
            local lookCF = CFrame.lookAt(humanoidRootPart.Position, vector3)
            humanoidRootPart.CFrame = humanoidRootPart.CFrame:Lerp(lookCF, (elapsed < 0.05) and tbl.LoopConfig.FLICK_INTENSITY or tbl.LoopConfig.FLICK_SMOOTHING)
            
            if tbl.AutoFlickCam and target then
                local currentCamCF = Camera.CFrame
                local camPos = currentCamCF.Position
                
                -- Nếu chọn chế độ DrawTech và đã vẽ đường nét, camera sẽ flick theo đúng hình vẽ
                if tbl.TechMode == "DrawTech" and #drawPoints > 0 then
                    local pointIndex = math.clamp(math.floor((elapsed / tbl.LoopConfig.LOCK_DURATION) * #drawPoints) + 1, 1, #drawPoints)
                    local p = drawPoints[pointIndex]
                    local targetDir = (vector3 - humanoidRootPart.Position).Unit
                    local sideOffset = (p.X - 90) * 0.04
                    local upOffset = (p.Y - 75) * 0.025
                    local offset = Vector3.new(sideOffset, -upOffset, 0)
                    
                    local fixedLook = CFrame.lookAt(camPos, camPos + Vector3.new(targetDir.X, 0, targetDir.Z) + offset)
                    Camera.CFrame = currentCamCF:Lerp(fixedLook, 0.9)
                else
                    local targetDir = (vector3 - humanoidRootPart.Position).Unit
                    local fixedLook = CFrame.lookAt(camPos, camPos + Vector3.new(targetDir.X, 0, targetDir.Z))
                    Camera.CFrame = currentCamCF:Lerp(fixedLook, 0.9)
                end
            end
        end)
    end)

    task.delay(tbl.LoopConfig.LOCK_DURATION + 0.5, function()
        pcall(function()
            if humanoid and humanoid.Parent then humanoid.AutoRotate = true end
            flag = false
        end)
        pcall(function()
            if connection and connection.Connected then connection:Disconnect() end
        end)
    end)
end

local function func6()
    local Communicate = v1:FindFirstChild("Communicate")
    if Communicate then
        Communicate:FireServer({Dash = Enum.KeyCode.W, Key = Enum.KeyCode.Q, Goal = "KeyPress"})
    end
end

-- Hàm thực thi Tech với tùy chọn độ trễ (customDelay = 0 khi bấm nút E/TECH, hoặc dùng LOOP_DELAY khi nối combo Uppercut)
local function executeTechWithDelay(customDelay)
    if not tbl.Enabled or flag then return end
    if (tick() - lastExecutionTime) < tbl.LoopConfig.DASH_COOLDOWN then return end

    local currentTarget = func4() or tbl3.GetClosestTarget()
    if not currentTarget then return end

    func3()
    if flag then return end
    flag = true

    local waitTime = customDelay or tbl.LoopConfig.LOOP_DELAY

    task.spawn(function()
        local spawnNum = num
        if waitTime > 0 then
            task.wait(waitTime)
        end

        if not func4() or not flag1 or spawnNum ~= num or not HumanoidRootPart then
            flag = false
            return
        end

        local hrp = HumanoidRootPart
        local v3 = math.min(tbl.LoopConfig.JUMP_VELOCITY, 18)
        hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, v3, hrp.AssemblyLinearVelocity.Z)

        func6()
        task.wait(tbl.LoopConfig.FLICK_DELAY)

        if flag1 and spawnNum == num then
            if func4() then func5() end
        end

        lastExecutionTime = tick()
        flag = false
    end)
end

local function func7()
    local npcTable = {}
    local function searchFolder(folder)
        if not folder then return end
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") and child ~= v1 and child ~= tbl2.Character then
                local hum = child:FindFirstChildOfClass("Humanoid")
                local hrp = child:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    table.insert(npcTable, hrp)
                end
            end
        end
    end
    searchFolder(Workspace)
    searchFolder(Workspace:FindFirstChild("Live"))
    searchFolder(Workspace:FindFirstChild("Characters"))
    tbl2.NpcList = npcTable
    tbl1.NpcList = npcTable
end

local function func8(character)
    num = num + 1
    v1 = character
    HumanoidRootPart = v1:WaitForChild("HumanoidRootPart")
    Humanoid = v1:WaitForChild("Humanoid")
    Animator = Humanoid:WaitForChild("Animator")
    tbl2.Character = character
    tbl2.RootPart = HumanoidRootPart
    tbl2.Humanoid = Humanoid
    tbl2.Animator = Animator
    flag = false
    tbl1.IsChecking = false
    tbl2.IsChecking = false

    tbl3.ClearConnections()
    pcall(function()
        Humanoid.BreakJointsOnDeath = false
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    end)
end

local function func13(animatorObj, currentNum)
    animatorObj.AnimationPlayed:Connect(function(track)
        if currentNum ~= num or not flag1 or not tbl.Enabled then return end

        for k in pairs(tbl.TargetAnimations) do
            if string.find(track.Animation.AnimationId, k) then
                task.wait(0.01)
                func2()
                break
            end
        end

        if track.Animation.AnimationId == "rbxassetid://10479335397" and flag then
            local hrp = HumanoidRootPart
            task.delay(tbl.LoopConfig.DASH_CANCEL_DELAY, function()
                if currentNum ~= num or not hrp or not hrp.Parent then return end
                hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
                for _, child in ipairs(hrp:GetChildren()) do
                    if child:IsA("BodyVelocity") or child:IsA("LinearVelocity") then child:Destroy() end
                end
            end)
        end

        -- Tự động nối combo sau khi Uppercut đánh trúng (sử dụng LOOP_DELAY = 0.31s để không dash sớm)
        if track.Animation.AnimationId == "rbxassetid://10503381238" then
            executeTechWithDelay(tbl.LoopConfig.LOOP_DELAY)
        end
    end)
end

