local function addOption(labelText, key, defaultVal, posY)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.56, -8, 0, 28)
    lbl.Position = UDim2.fromOffset(8, posY)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(230, 230, 245)
    lbl.TextSize = 11
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = scrollingFrame

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.4, 0, 0, 24)
    box.Position = UDim2.fromOffset(148, posY)
    box.BackgroundColor3 = Color3.fromRGB(25, 25, 40)
    box.Text = tostring(defaultVal)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextSize = 11
    box.Font = Enum.Font.GothamMedium
    box.Parent = scrollingFrame
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 5)

    box.FocusLost:Connect(function(enter)
        if enter then
            local text = box.Text
            if key == "PC_KEY" then
                local foundKey = Enum.KeyCode[text:upper()]
                if foundKey then
                    tbl.ActivationKey = foundKey
                    box.Text = text:upper()
                else
                    box.Text = tostring(tbl.ActivationKey.Name)
                end
            else
                local n = tonumber(text)
                if n then
                    if key == "DASH_COOLDOWN" then tbl.LoopConfig.DASH_COOLDOWN = math.max(0, n)
                    elseif key == "PullForce" then tbl.PullForce = n
                    elseif key == "DASH_CANCEL_DELAY" then tbl.LoopConfig.DASH_CANCEL_DELAY = n
                    elseif key == "LOCK_DURATION" then tbl.LoopConfig.LOCK_DURATION = n
                    elseif key == "LOOP_DELAY" then tbl.LoopConfig.LOOP_DELAY = n
                    elseif key == "FLICK_DELAY" then tbl.LoopConfig.FLICK_DELAY = n
                    elseif key == "JUMP_VELOCITY" then tbl.LoopConfig.JUMP_VELOCITY = math.min(n, 30)
                    elseif key == "FLICK_INTENSITY" then tbl.LoopConfig.FLICK_INTENSITY = n
                    elseif key == "FLICK_SMOOTHING" then tbl.LoopConfig.FLICK_SMOOTHING = n
                    elseif key == "TP_Time" then tbl.FraudConfig.TP_Time = math.clamp(n, 0.6, 0.78)
                    end
                end
            end
        end
    end)
    tbl4[key] = box
end

